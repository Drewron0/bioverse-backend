# Server configuration
APP_NAME=BioVerse
APP_ENV=development
PORT=8080
LOG_LEVEL=debug
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# Database configuration (PostgreSQL 16)
DATABASE_URL=postgres://bioverse:bioverse_dev@127.0.0.1:5433/bioverse?sslmode=disable
DB_NAME=bioverse
DB_USER=bioverse
DB_PASSWORD=bioverse_dev
DB_PORT=5433
DB_MAX_CONNS=25
DB_MIN_CONNS=5
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m

# Authentication and cryptography
JWT_SECRET=super_secret_key_bioverse_2026_change_in_production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h
APP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
HMAC_SECRET=hmac_secret_key_for_searchable_hashes

# Object storage (MinIO locally / AWS S3 in production)
STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_ACCESS_KEY=bioverse_minio
STORAGE_SECRET_KEY=bioverse_minio_secret
STORAGE_BUCKET_NAME=bioverse-media
STORAGE_REGION=us-east-1
STORAGE_USE_SSL=false

# Payment gateway (Xendit MVP)
XENDIT_SECRET_KEY=xnd_development_placeholder
XENDIT_WEBHOOK_TOKEN=webhook_verification_token_placeholder

# Google OAuth
GOOGLE_CLIENT_ID=google_client_id_placeholder

# Transactional Email (Resend - optional for dev/testing)
RESEND_API_KEY=re_placeholder
EMAIL_FROM=BioVerse <onboarding@resend.dev>

# Push notifications (Firebase Cloud Messaging - optional)
FCM_CREDENTIALS_JSON_PATH=

# Computer vision service
CV_SERVICE_URL=http://localhost:8001
CV_MIN_CONFIDENCE=0.80
